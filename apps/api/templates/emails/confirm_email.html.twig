{% extends 'emails/_layout.html.twig' %}

{% block title %}Confirm your email address{% endblock %}

{% block content %}
    <h1 style="margin: 0 0 6px; font-size: 26px; line-height: 32px">Confirm your email address</h1>
    <p style="margin: 0 0 18px; font-size: 14px; line-height: 20px; color: #4A505C">Hi {{ name }}, confirm this address to finish creating your Varve account. The link works for two days.</p>
    <p style="margin: 0 0 24px"><a href="{{ link }}" style="display: inline-block; padding: 10px 16px; border-radius: 6px; background: #16181D; color: #FFFFFF; font-size: 14px; font-weight: 600; text-decoration: none">Confirm address</a></p>
    <p style="margin: 0; font-size: 13px; line-height: 18px; color: #4A505C">If you did not create a Varve account, ignore this mail: nobody can sign in with this address until it is confirmed.</p>
{% endblock %}

{% extends 'emails/_layout.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block content %}
    <h1 style="margin: 0 0 6px; font-size: 26px; line-height: 32px">Reset your password</h1>
    <p style="margin: 0 0 18px; font-size: 14px; line-height: 20px; color: #4A505C">Hi {{ name }}, someone asked to set a new password for your Varve account. The link works for an hour. Setting a new password signs your account out on every device.</p>
    <p style="margin: 0 0 24px"><a href="{{ link }}" style="display: inline-block; padding: 10px 16px; border-radius: 6px; background: #16181D; color: #FFFFFF; font-size: 14px; font-weight: 600; text-decoration: none">Set a new password</a></p>
    <p style="margin: 0; font-size: 13px; line-height: 18px; color: #4A505C">If you did not ask for this, ignore this mail: your password stays as it is.</p>
{% endblock %}

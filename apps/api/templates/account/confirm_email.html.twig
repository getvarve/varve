{% extends 'base.html.twig' %}

{% block title %}Confirm your address{% endblock %}

{% block body %}
    <section class="card" aria-labelledby="confirm-title">
        {% if state == 'ask' %}
            <h1 id="confirm-title">Confirm your address</h1>
            <p class="lead">Enter the password you chose when you signed up. That confirms this address for your Varve account, and then you can sign in.</p>

            {% include 'account/_form_error.html.twig' %}

            <form class="form" method="post" action="{{ path('app_confirm_email') }}" novalidate>
                <label class="field" for="password">
                    Password
                    <input type="password" id="password" name="password" autocomplete="current-password" required autofocus{% if errors.password is defined %} aria-invalid="true" aria-describedby="password-error"{% endif %}>
                    {% if errors.password is defined %}<span class="field-error" id="password-error">{{ errors.password }}</span>{% endif %}
                </label>

                <input type="hidden" name="token" value="{{ token }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('confirm_email') }}">

                <button type="submit" class="button">Confirm</button>
            </form>

            <p class="links">Did not sign up yourself? Then someone else used your address, and this link is theirs: ignore it, or <a href="{{ path('app_register') }}">sign up yourself</a>, which ends it.</p>
        {% elseif state == 'confirmed' %}
            <h1 id="confirm-title">Address confirmed</h1>
            <p class="lead">Your Varve account is ready. Sign in from the Varve app, or here.</p>
            <p class="links"><a href="{{ path('app_login') }}">Sign in</a></p>
        {% elseif state == 'expired' %}
            <h1 id="confirm-title">Link expired</h1>
            <p class="lead">This link worked for two days. We can send a new one to the same address.</p>
            <form class="form" method="post" action="{{ path('app_resend_confirmation') }}">
                <input type="hidden" name="link" value="{{ token }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('resend_confirmation') }}">
                <button type="submit" class="button">Send a new link</button>
            </form>
        {% else %}
            <h1 id="confirm-title">Link no longer works</h1>
            <p class="lead">This link was used already, or a newer one was sent since. If your address is not confirmed yet, ask for a new link.</p>
            <p class="links"><a href="{{ path('app_resend_confirmation') }}">Send a new link</a> or <a href="{{ path('app_login') }}">sign in</a></p>
        {% endif %}
    </section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Set a new password{% endblock %}

{% block body %}
    <section class="card" aria-labelledby="reset-title">
        {% if state == 'form' %}
            <h1 id="reset-title">Set a new password</h1>
            <p class="lead">Every device and browser signed in to your account is signed out; sign in again with the new password.</p>

            {% include 'account/_form_error.html.twig' %}

            <form class="form" method="post" action="{{ path('app_reset_password') }}" novalidate>
                <label class="field" for="password">
                    New password
                    <input type="password" id="password" name="password" autocomplete="new-password" minlength="12" required autofocus aria-describedby="password-hint{% if errors.password is defined %} password-error{% endif %}"{% if errors.password is defined %} aria-invalid="true"{% endif %}>
                    <span class="field-hint" id="password-hint">At least 12 characters.</span>
                    {% if errors.password is defined %}<span class="field-error" id="password-error">{{ errors.password }}</span>{% endif %}
                </label>

                <input type="hidden" name="token" value="{{ token }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

                <button type="submit" class="button">Set password</button>
            </form>
        {% elseif state == 'done' %}
            <h1 id="reset-title">Password set</h1>
            <p class="lead">Your new password works now. Every device was signed out; sign in again from the Varve app, or here.</p>
            <p class="links"><a href="{{ path('app_login') }}">Sign in</a></p>
        {% elseif state == 'expired' %}
            <h1 id="reset-title">Link expired</h1>
            <p class="lead">This link worked for an hour. We can send a new one to the same address.</p>
            <form class="form" method="post" action="{{ path('app_forgot_password') }}">
                <input type="hidden" name="link" value="{{ token }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                <button type="submit" class="button">Send a new link</button>
            </form>
        {% else %}
            <h1 id="reset-title">Link no longer works</h1>
            <p class="lead">This link was used already, or a newer one was sent since. Ask for a new one.</p>
            <p class="links"><a href="{{ path('app_forgot_password') }}">Send a new link</a></p>
        {% endif %}
    </section>
{% endblock %}

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> league/oauth2-server-bundle ###
# The key pair access tokens are signed with, made once per server in config/jwt and never committed (README.md), and
# the key refresh tokens are encrypted with. Development values only: production sets its own passphrase (at least
# 16 characters) and encryption key (at least 32).
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/jwt/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
OAUTH_PASSPHRASE=bc579f574f0955a219d6fe89a67502eb
OAUTH_ENCRYPTION_KEY=ae08bc1f5adbb2207606ca69fceab39f
###< league/oauth2-server-bundle ###

###> nelmio/cors-bundle ###
# Development allows any localhost port and the desktop app. A production server lists its origins separated by
# spaces instead (see App\Deployment\CorsOrigins).
CORS_ALLOW_ORIGIN='^(https?://(localhost|127\.0\.0\.1)(:[0-9]+)?|tauri://localhost|http://tauri\.localhost)$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Where account mail (address confirmation, password reset) goes out. null://null sends nothing; production sets its
# mail server, such as smtp://user:password@smtp.example.com:587.
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/public-addresses ###
# The API as clients reach it: the token endpoint and the issuer of every token are built on it. A production server
# sets its https origin, such as https://varve.example.com.
API_PUBLIC_URL=http://localhost:8090
###< app/public-addresses ###

###> app/accounts ###
# The sender of every mail the server sends itself. Production sets an address of its own domain.
VARVE_MAIL_FROM="Varve <accounts@localhost>"
# Whether anyone may sign up (1), or only an operator adds users with `bin/console app:users:create` (0).
VARVE_SIGN_UP=1
# The web client, once it has a deployment: its sign-in returns to <WEB_APP_URL>/auth/callback. Empty: this server has
# no web client, and only the desktop app signs in.
WEB_APP_URL=
# Sign-in sessions, login limits and the refresh token grace of a production server live in Redis, shared by every
# API instance. Development and tests keep them in files.
REDIS_URL=redis://localhost:6379
###< app/accounts ###

###> app/billing ###
# Varve Cloud bills organizations; any other server leaves VARVE_BILLING at 0 and never bills or blocks anyone.
# GET /api/v1/server-info tells the apps which of the two this server is.
VARVE_BILLING=0
###< app/billing ###

###> app/sync ###
# The most live synced records (connection profiles, folders, saved queries) one organization may hold, and the most
# per-user records (favourites, preferences, overrides) one user may hold. Generous; a push past them is rejected.
VARVE_SYNC_MAX_RECORDS=50000
VARVE_SYNC_MAX_USER_RECORDS=10000
# The most bytes the payloads of those live records may add up to: 512 MiB per organization and 64 MiB per user. One
# payload is at most 256 KiB. A push that would go past them is rejected.
VARVE_SYNC_MAX_BYTES=536870912
VARVE_SYNC_MAX_USER_BYTES=67108864
# Earlier versions kept per saved query: the newest 50 (design 8.11), and at most 8 MiB of them per query.
VARVE_SYNC_MAX_REVISIONS=50
VARVE_SYNC_MAX_REVISION_BYTES=8388608
###< app/sync ###

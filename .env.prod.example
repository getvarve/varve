# The settings of compose.prod.yaml. Copy this file to .env next to compose.prod.yaml and fill in every empty value;
# docs/hosting.md explains each one. Docker Compose refuses to start while one of them is empty, and the API refuses to
# start while one is too short or a development value from the repository.

# The address the desktop app reaches this server at: https, the host name in lower case, no path, no trailing slash.
# Its DNS name must point at this machine. For example: https://varve.example.com
VARVE_API_URL=

# Signs what the server hands out. At least 32 characters; generate it with: openssl rand -hex 32
APP_SECRET=

# The database password. At least 16 characters, letters and digits only (it goes into a URL); generate it with:
# openssl rand -hex 24
# Set it before the first start and keep it: the database takes it once, when its volume is created.
POSTGRES_PASSWORD=

# The OAuth2 sign-in secrets. OAUTH_PASSPHRASE encrypts the signing key the server makes on its first start: at least
# 16 characters; generate it with: openssl rand -hex 24
# Set it before the first start and keep it: a new passphrase needs a new signing key, which signs every app out.
OAUTH_PASSPHRASE=
# Encrypts refresh tokens and authorization codes. At least 32 characters; generate it with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=

# Account mail (address confirmation and password reset links) goes out through this mail server, such as
# smtp://user:password@smtp.example.com:587 (a password with special characters is URL-encoded). Without working
# mail nobody can confirm an address or reset a password.
MAILER_DSN=
# The sender of that mail: an address on a domain of your own that the mail server may send for, such as
# Varve <accounts@varve.example.com> (in quotes, because of the space).
VARVE_MAIL_FROM=

# Optional: the web client's address (https, lower case, no path, no trailing slash), once you run one. Left out, only
# the desktop app signs in.
# VARVE_WEB_URL=

# Optional: the release to run, such as 0.4.0. Left out, the newest release (latest).
# VARVE_VERSION=

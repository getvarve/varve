<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS 26 and later: the Liquid Glass icon in Contents/Resources/Assets.car (scripts/liquid-glass-icon.sh).
	     Older macOS uses CFBundleIconFile, which Tauri sets to icon.icns. -->
	<key>CFBundleIconName</key>
	<string>Varve</string>
	<!-- Sparkle (crates/sparkle): updates are signed with this EdDSA key; the private key is in
	     1Password and the SPARKLE_ED_PRIVATE_KEY secret. Checks run daily by default. -->
	<key>SUPublicEDKey</key>
	<string>EMmMripa2lO/Y1PRisCPpv9Djb/3VZE8fbGEIj2UJG0=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>

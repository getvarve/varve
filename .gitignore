# Varve server (apps/api): its .env files hold development defaults only and are committed, as Symfony expects.
# Real secrets go in .env.local files, which stay ignored.
!/apps/api/.env
!/apps/api/.env.dev
!/apps/api/.env.test
/apps/api/vendor/
/apps/api/var/
/apps/api/.phpunit.cache/
